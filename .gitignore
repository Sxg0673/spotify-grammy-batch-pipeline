# Entorno virtual local (se reconstruye desde el archivo de dependencias)
.venv/

# Secretos: nunca se versionan. La plantilla es .env.example
.env

# Artefactos de Python
__pycache__/
*.py[cod]

# Checkpoints automáticos de Jupyter
.ipynb_checkpoints/

# Archivos del sistema macOS
.DS_Store

# Airflow: generado en ejecución
logs/*
!logs/.gitkeep
config/airflow.cfg

# Datos intermedios por corrida
data/work/

# Fuentes alteradas para pruebas (se regeneran con src/make_bad_source.py)
data/raw/*_bad.csv

# Archivos temporales de Tableau
.~*
*.twbr
