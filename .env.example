# Plantilla de variables. Copiar como .env y completar. NUNCA versionar .env.
# Generar secretos con: openssl rand -hex 16

# Airflow (en Linux: AIRFLOW_UID=$(id -u); en macOS basta 50000)
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Base de metadatos de Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow
AIRFLOW_JWT_SECRET=

# Usuario de la UI de Airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# PostgreSQL de datos: fuente (grammy_source) y Data Warehouse (music_dw)
DATA_PG_ADMIN_USER=admin
DATA_PG_ADMIN_PASSWORD=
DATA_PG_ETL_USER=etl_user
DATA_PG_ETL_PASSWORD=
DATA_PG_PUBLISHED_PORT=5432
SOURCE_DB_NAME=grammy_source
DW_DB_NAME=music_dw
